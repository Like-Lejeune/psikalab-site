---
import Base from '../../layouts/Base.astro';
import { useT, path, getStaticLangPaths, type Lang } from '../../i18n/ui';
import { getContent } from '../../lib/content';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { site, team } = await getContent();
const subjects = ['project', 'partner', 'event', 'press', 'other'];
---
<Base lang={lang} page="contact" title={t('contact.title')}>
  <section class="container contact-grid">
    <div style="flex:1 1 380px;display:flex;flex-direction:column;gap:24px">
      <p class="eyebrow">{t('contact.title')}</p>
      <h1 class="h1">{t('contact.h1')}</h1>
      <p class="lead" style="font-size:18px;max-width:460px">{t('contact.lead', { days: site.contact.replyDays })}</p>
      <dl class="coords">
        <div><dt class="label">{t('contact.email')}</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd></div>
        <div><dt class="label">{t('contact.phone')}</dt><dd>{site.contact.phone}</dd></div>
        <div><dt class="label">{t('contact.address')}</dt><dd>{site.contact.address[lang]}</dd></div>
      </dl>
    </div>

    <div class="panel" style="flex:1.3 1 460px">
      <form class="js-form form" data-form="contact" data-lang={lang} aria-label={t('contact.form')} novalidate>
        <div class="js-fields form">
          <div class="form-row">
            <div class="field"><label class="label" for="c-name">{t('form.name')}</label><input id="c-name" name="name" class="input" required maxlength="120" autocomplete="name" placeholder={t('form.name.ph')} /></div>
            <div class="field"><label class="label" for="c-email">{t('form.email')}</label><input id="c-email" name="email" type="email" class="input" required maxlength="160" autocomplete="email" placeholder={t('form.email.ph')} /></div>
          </div>
          <div class="field">
            <label class="label" for="c-subject">{t('contact.subject')}</label>
            <select id="c-subject" name="subject" class="input">
              {subjects.map((s) => <option value={s}>{t(`contact.subject.${s}` as any)}</option>)}
            </select>
          </div>
          <div class="field"><label class="label" for="c-message">{t('contact.message')}</label><textarea id="c-message" name="message" class="input" rows="6" required minlength="10" maxlength="5000" placeholder={t('contact.message.ph')}></textarea></div>
          <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="js-error form-error" role="alert" hidden>{t('form.error', { email: site.contact.email })}</p>
          <div class="form-foot">
            <span class="form-note">{t('contact.consent')} <a href={path(lang, 'privacy')}>{t('form.privacy')}</a>.</span>
            <button type="submit" class="btn btn-primary btn-lg" data-label={t('contact.send')} data-sending={t('form.sending')}>{t('contact.send')}</button>
          </div>
        </div>
        <div class="js-done form-done" role="status" tabindex="-1" hidden>
          <div class="form-done-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg></div>
          <h2 class="h3" style="font-size:28px">{t('contact.done.title')}</h2>
          <p class="muted" style="margin:0">{t('contact.done.text')}</p>
          <button type="button" class="btn btn-ghost js-again">{t('contact.done.again')}</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section-alt" aria-labelledby="team-title">
    <div class="container" style="padding-top:96px;padding-bottom:96px">
      <div class="section-head">
        <h2 id="team-title" class="h2">{t('contact.team')}</h2>
        <a class="btn btn-ghost" href={path(lang, 'join')}>{t('contact.team.join')}</a>
      </div>
      <ul class="team">
        {team.map((m) => (
          <li class="member">
            {m.photo
              ? <img class="avatar" src={m.photo} alt="" loading="lazy" width="72" height="72" />
              : <span class="avatar" aria-hidden="true">{m.initials}</span>}
            <span class="h3" style="font-size:20px">{m.name}</span>
            <span class="muted" style="font-size:14px">{m[lang].role}</span>
            {m.linkedin && <a href={m.linkedin} target="_blank" rel="noopener" style="margin-top:10px;font-size:14px;color:var(--soft)">LinkedIn →</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: flex; flex-wrap: wrap; gap: 64px; padding-top: 96px; padding-bottom: 96px; }
  .coords { margin: 16px 0 0; padding-top: 32px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 20px; }
  .coords dd { margin: 4px 0 0; font-size: 18px; color: var(--text-strong); }
  .coords a { text-decoration: none; color: var(--text-strong); }
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .member { display: flex; flex-direction: column; gap: 6px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); }
  .avatar { width: 72px; height: 72px; margin-bottom: 12px; border-radius: 50%; background: var(--line); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--accent); object-fit: cover; }
</style>
