---
import Base from '../../layouts/Base.astro';
import { useT, path, getStaticLangPaths, type Lang } from '../../i18n/ui';
import { getContent, type EventItem } from '../../lib/content';

export const getStaticPaths = getStaticLangPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { events } = await getContent();
const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';

type Ev = EventItem;

function dateParts(e: Ev) {
  if (!e.date) return { month: t('events.month.tbd'), day: '—', long: t('events.tbd') };
  const d = new Date(`${e.date}T12:00:00Z`);
  return {
    month: d.toLocaleDateString(locale, { month: 'short', timeZone: 'UTC' }).replace('.', ''),
    day: d.toLocaleDateString(locale, { day: '2-digit', timeZone: 'UTC' }),
    long: d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
  };
}

// Événements à venir (date passée = masqué), dates inconnues à la fin.
const today = new Date().toISOString().slice(0, 10);
const list = events
  .filter((e) => !e.date || e.date >= today)
  .sort((a, b) => (a.date ?? '9999').localeCompare(b.date ?? '9999'));
const featured = list.filter((e) => e.featured);

const locations = ['all', 'yaounde', 'douala', 'abidjan', 'dakar', 'online'];
const types = ['all', 'psikalab', 'hackathon', 'workshop'];
const placeLabel = (e: Ev) => {
  const city = t(`events.loc.${e.location}` as any);
  return e.venue && e.location !== 'online' ? `${e.venue}, ${city}` : city;
};
const featuredColors = ['var(--accent)', '#F2F1EC', '#4D9FFF', '#FF6B35'];
---
<Base lang={lang} page="events" title={t('events.title')}>
  <div class="container" style="padding-top:72px;padding-bottom:112px">

    <section aria-labelledby="discover">
      <div class="section-head" style="margin-bottom:28px">
        <h1 id="discover" class="h1">{t('events.discover')}</h1>
        {featured.length > 1 && (
          <div style="display:flex;align-items:center;gap:12px">
            <span class="label js-slide-label" aria-live="polite">1 / {featured.length}</span>
            <button type="button" class="round-btn js-prev" aria-label={t('events.prev')}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <button type="button" class="round-btn js-next" aria-label={t('events.next')}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </button>
          </div>
        )}
      </div>
      {featured.map((e, i) => {
        const d = dateParts(e);
        const c = e[lang] as { title: string; description: string; kind?: string };
        return (
          <article class="featured js-slide" hidden={i > 0}>
            <div class="featured-visual" style={`background:${featuredColors[i % featuredColors.length]}`}>
              <span class="label" style="color:var(--on-accent)">{c.kind ?? t(`events.tag.${e.type}` as any)}</span>
              <span class="featured-big">{e.badge ?? ''}</span>
            </div>
            <div class="featured-body">
              <span style="font-family:var(--font-mono);font-size:14px;color:var(--accent)">{d.long}{e.date && e.time ? ` · ${e.time} ${e.timezone}` : ''}</span>
              <h2 class="h3" style="font-size:34px;line-height:1.05;letter-spacing:-.03em">{c.title}</h2>
              <p class="muted" style="margin:0">{c.description}</p>
              <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:8px">
                {e.registerUrl
                  ? <a class="btn btn-primary" href={e.registerUrl} target="_blank" rel="noopener">{t('events.register')}</a>
                  : <span class="tag tag-accent">{t('events.soon')}</span>}
                <span style="color:var(--soft)">{placeLabel(e)}</span>
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <section aria-label={t('events.filters')} style="margin-top:72px;display:flex;flex-direction:column;gap:16px">
      <div class="filter-row" role="group" aria-label={t('events.location')}>
        <span class="label filter-label">{t('events.location')}</span>
        {locations.map((l) => (
          <button type="button" class="pill js-filter" data-group="location" data-value={l} aria-pressed={l === 'all' ? 'true' : 'false'}>{t(`events.loc.${l}` as any)}</button>
        ))}
      </div>
      <div class="filter-row" role="group" aria-label={t('events.type')}>
        <span class="label filter-label">{t('events.type')}</span>
        {types.map((ty) => (
          <button type="button" class="pill js-filter" data-group="type" data-value={ty} aria-pressed={ty === 'all' ? 'true' : 'false'}>{t(`events.type.${ty}` as any)}</button>
        ))}
      </div>
    </section>

    <section aria-labelledby="upcoming" style="margin-top:56px">
      <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--line)">
        <h2 id="upcoming" class="h3" style="font-size:28px">{t('events.upcoming')}</h2>
        <span class="label js-count" aria-live="polite" data-one={t('events.count.one')} data-many={t('events.count.many')}>{list.length} {list.length > 1 ? t('events.count.many') : t('events.count.one')}</span>
      </div>
      <ul class="event-list">
        {list.map((e) => {
          const d = dateParts(e);
          const c = e[lang] as { title: string; description: string };
          const Tag = e.registerUrl ? 'a' : 'div';
          return (
            <li class="js-event" data-location={e.location} data-type={e.type}>
              <Tag class="event-row" href={e.registerUrl || undefined} target={e.registerUrl ? '_blank' : undefined} rel={e.registerUrl ? 'noopener' : undefined}>
                <div class="event-date" aria-hidden="true">
                  <span>{d.month}</span>
                  <strong>{d.day}</strong>
                </div>
                <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:8px">
                  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px">
                    <h3 class="h3">{c.title}</h3>
                    <span class="tag">{t(`events.tag.${e.type}` as any)}</span>
                  </div>
                  <span style="font-size:14px;color:var(--soft)">{d.long}{e.date && e.time ? ` · ${e.time} ${e.timezone}` : ''} · {placeLabel(e)}</span>
                  <p class="muted" style="margin:0;max-width:720px;font-size:15px">{c.description}</p>
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
      <p class="js-empty muted" hidden style="padding:56px 0;text-align:center;margin:0">{t('events.empty')}</p>
    </section>

    <section class="panel" aria-labelledby="submit-title" style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px">
      <div style="flex:1 1 420px;display:flex;flex-direction:column;gap:12px">
        <h2 id="submit-title" class="h3" style="font-size:34px;letter-spacing:-.03em">{t('events.submit.title')}</h2>
        <p class="muted" style="margin:0">{t('events.submit.text')}</p>
      </div>
      <a class="btn btn-primary btn-lg" href={path(lang, 'contact')}>{t('events.submit.cta')}</a>
    </section>
  </div>
</Base>

<style>
  .round-btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line-2); background: transparent; color: var(--text-strong); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .round-btn:hover { border-color: var(--soft); }
  .featured { display: flex; flex-wrap: wrap; border-radius: 24px; overflow: hidden; border: 1px solid var(--line); background: var(--bg-2); }
  .featured-visual { flex: 1 1 420px; min-height: 320px; padding: 40px; display: flex; flex-direction: column; justify-content: space-between; color: var(--on-accent); }
  .featured-big { font-family: var(--font-display); font-size: clamp(56px, 8vw, 120px); font-weight: 700; line-height: .9; letter-spacing: -.05em; }
  .featured-body { flex: 1 1 420px; padding: 40px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  @media (max-width: 640px) { .featured-visual, .featured-body { padding: 24px; } .featured-visual { min-height: 220px; } }
  .filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .filter-label { width: 110px; }
  .event-list { list-style: none; margin: 0; padding: 0; }
  .event-row { display: flex; flex-wrap: wrap; gap: 20px 32px; padding: 28px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; }
  a.event-row:hover .h3 { color: var(--accent); }
  .event-date { flex: 0 0 72px; height: 76px; border: 1px solid var(--line-2); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; }
  .event-date span { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; color: var(--accent); }
  .event-date strong { font-family: var(--font-display); font-size: 28px; font-weight: 600; line-height: 1; color: var(--text-strong); }
</style>

<script>
  // Carrousel "Découvrir"
  const slides = [...document.querySelectorAll<HTMLElement>('.js-slide')];
  const label = document.querySelector('.js-slide-label');
  let current = 0;
  const show = (i: number) => {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, k) => (s.hidden = k !== current));
    if (label) label.textContent = `${current + 1} / ${slides.length}`;
  };
  document.querySelector('.js-prev')?.addEventListener('click', () => show(current - 1));
  document.querySelector('.js-next')?.addEventListener('click', () => show(current + 1));

  // Filtres lieu / type
  const state: Record<string, string> = { location: 'all', type: 'all' };
  const items = [...document.querySelectorAll<HTMLElement>('.js-event')];
  const count = document.querySelector<HTMLElement>('.js-count');
  const empty = document.querySelector<HTMLElement>('.js-empty');
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.js-filter')) {
    btn.addEventListener('click', () => {
      const group = btn.dataset.group!;
      state[group] = btn.dataset.value!;
      document.querySelectorAll<HTMLButtonElement>(`.js-filter[data-group="${group}"]`)
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      for (const it of items) {
        const ok = (state.location === 'all' || it.dataset.location === state.location)
          && (state.type === 'all' || it.dataset.type === state.type);
        it.hidden = !ok;
        if (ok) n++;
      }
      if (count) count.textContent = `${n} ${n > 1 ? count.dataset.many : count.dataset.one}`;
      if (empty) empty.hidden = n > 0;
    });
  }
</script>
