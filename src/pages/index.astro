---
// Racine du site : redirige vers /fr/ ou /en/ selon la langue du navigateur.
// (Sur Hostinger, le .htaccess fait déjà cette redirection côté serveur ;
// cette page sert de secours.)
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>PsikaLab</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/fr/" />
    <meta http-equiv="refresh" content="1; url=/fr/" />
    <script is:inline>
      var l = (navigator.language || 'fr').slice(0, 2).toLowerCase();
      location.replace(l === 'en' ? '/en/' : '/fr/');
    </script>
  </head>
  <body style="background:#0a0a0b;color:#e8e8e6;font-family:system-ui,sans-serif">
    <p><a href="/fr/" style="color:#c6f432">Français</a> · <a href="/en/" style="color:#c6f432">English</a></p>
  </body>
</html>
