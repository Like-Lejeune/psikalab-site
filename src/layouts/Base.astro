---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useT, otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Nom de la page dans l'URL, sans la langue : '' (accueil), 'events', 'work'… */
  page: string;
  title: string;
  description?: string;
}

const { lang, page, title, description } = Astro.props;
const t = useT(lang);
const site = Astro.site!;
const pagePath = page ? `${page}/` : '';
const canonical = new URL(`/${lang}/${pagePath}`, site).href;
const alternate = new URL(`/${otherLang(lang)}/${pagePath}`, site).href;
const fullTitle = page ? `${title} — PsikaLab` : `PsikaLab — ${title}`;
const desc = description ?? t('meta.description');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/fr/${pagePath}`, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PsikaLab" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
